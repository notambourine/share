/**
 * share.notambourine.com: artifact sharing Worker.
 * Deployed by Cloudflare Workers Builds (git integration), never `wrangler deploy` by hand.
 * Secrets (dashboard only, never here): TOKENS, SIGNING_KEYS, SPACE_TTLS.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "share",
	"compatibility_date": "2026-08-01",
	// @cloudflare/puppeteer imports node:buffer; the flag is what resolves it.
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	// src/skill.ts imports the plugin's SKILL.md and serves those exact bytes.
	// src/brand.ts does the same for the golden set in @notambourine/brand-kit,
	// so no brand stylesheet is ever copied into public/. The globs reach a
	// node_modules path because the rule matches the specifier, then resolves it.
	// The svg is the lockup: a PDF and an offline snapshot both need it in the
	// markup, not behind a URL.
	"rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.css", "**/*.svg"] }],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// The Worker owns every route: it must stamp X-Robots-Tag on assets too.
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "notambourine-share"
		}
	],
	// Browser Rendering, for the PDF and snapshot exports. This declaration is
	// the whole setup: the deploy applies it, and no account toggle exists.
	"browser": {
		"binding": "BROWSER"
	},
	// Workers AI, for `?transform=` on upload (src/transforms/). Same deal as
	// the browser binding, except the model it calls (DeepSeek V4 Flash) is
	// paid-only: the account must sit on the Workers Paid plan.
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "LINKS",
			"id": "12a7b1b8e090483583267b88ddba827b"
		}
	],
	"triggers": {
		"crons": ["17 9 * * *"]
	},
	"observability": {
		"enabled": true
	}
}
