/**
 * share.notambourine.com — artifact sharing Worker.
 * Deployed by Cloudflare Workers Builds (git integration), never `wrangler deploy` by hand.
 * Secrets (dashboard only, never here): TOKENS, SIGNING_KEYS, SPACE_TTLS.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "share",
	"compatibility_date": "2026-08-01",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// The Worker owns every route: it must stamp X-Robots-Tag on assets too.
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "notambourine-share"
		}
	],
	"kv_namespaces": [
		{
			"binding": "LINKS",
			// Dashboard: Storage & Databases → KV → create "share-links", paste its ID here.
			"id": "TODO_PASTE_KV_NAMESPACE_ID"
		}
	],
	"triggers": {
		"crons": ["17 9 * * *"]
	},
	"observability": {
		"enabled": true
	}
}
