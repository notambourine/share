node_modules/
.wrangler/
.dev.vars*
!.dev.vars.example
*.local.*
.DS_Store

# ~/.gitignore excludes .claude/ everywhere, and git will not descend into an
# excluded directory, so re-including one child needs all three lines.
# settings.json carries repo policy: silenced lights.
!.claude/
.claude/*
!.claude/settings.json

# Built from src/client/ by `npm run build:client`, which Workers Builds runs
# before it deploys. Committing them would give this code two sources of truth.
/public/render.js
/public/admin.js
/public/print.js
