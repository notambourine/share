node_modules/
.wrangler/
.dev.vars*
!.dev.vars.example
*.local.*
.DS_Store

# ~/.gitignore excludes .claude/ everywhere, and git will not descend into an
# excluded directory, so re-including one child needs all three lines.
# settings.json carries repo policy: silenced lights.
!.claude/
.claude/*
!.claude/settings.json

# Built by `npm run build:client`, which Workers Builds runs before it deploys.
# Committing any of it would give this repo a second source of truth: the three
# bundles come from src/client/, the two directories from the version of
# @notambourine/brand-kit that package.json pins.
/public/render.js
/public/admin.js
/public/print.js
/public/table.js
/public/fonts/
/public/logo/

# Live-model eval outputs, kept local for eyeballing (evals/transforms/README.md).
/evals/transforms/out/
