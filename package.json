    "@oxlint/plugins": "^1.78.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "marked": "18.0.9",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.30.0"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.0"
