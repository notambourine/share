{
  "name": "share",
  "private": true,
  "type": "module",
  "bin": {
    "nt-share": "bin/share.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "vendor": "node scripts/vendor.mjs",
